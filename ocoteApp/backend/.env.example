APP_ENV=development
DEPLOYMENT_MODE=local
# Official bootstrap timezone (D01 ratified 2026-11-24); not a runtime settings override.
ORGANIZATION_TIMEZONE=America/Mexico_City
DATABASE_URL=postgresql+psycopg://ocote_runtime:REPLACE_LOCALLY@127.0.0.1:5432/ocoteAppDatabase
MIGRATION_DATABASE_URL=postgresql+psycopg://ocote_migrador:REPLACE_LOCALLY@127.0.0.1:5432/ocoteAppDatabase
HEALTH_TOKEN=REPLACE_WITH_A_RANDOM_MONITOR_TOKEN_AT_LEAST_32_CHARACTERS
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=0
DB_POOL_TIMEOUT=3
DB_CONNECT_TIMEOUT=3
DB_STATEMENT_TIMEOUT_MS=5000
DB_LOCK_TIMEOUT_MS=2000
DB_IDLE_TRANSACTION_TIMEOUT_MS=10000
# Managed connections: use a direct endpoint for migration, sslmode=verify-full
# and sslrootcert=<readable-CA-path> in each DSN. Never use these local examples remotely.