    {
      "label": "OCOTE F12: build Architect",
      "type": "process",
      "command": "node",
      "args": ["-e", "const dependency=require('node:module').createRequire(require.resolve('@angular/cli/package.json'));const {Architect}=dependency('@angular-devkit/architect'); const {WorkspaceNodeModulesArchitectHost}=dependency('@angular-devkit/architect/node'); const {workspaces,logging,schema}=dependency('@angular-devkit/core'); const {NodeJsSyncHost}=dependency('@angular-devkit/core/node'); (async()=>{const {workspace}=await workspaces.readWorkspace('angular.json',workspaces.createWorkspaceHost(new NodeJsSyncHost()));const registry=new schema.CoreSchemaRegistry();registry.addPostTransform(schema.transforms.addUndefinedDefaults);const architect=new Architect(new WorkspaceNodeModulesArchitectHost(workspace,process.cwd()),registry);const logger=new logging.Logger('F12');logger.subscribe(entry=>console.log(entry.message));const run=await architect.scheduleTarget({project:'ocoteApp',target:'build',configuration:'production'},{watch:false,progress:false},{logger});const result=await run.result;console.log('F12_ARCHITECT_RESULT='+JSON.stringify({success:result.success,target:result.target}));if(typeof result.success!=='boolean')throw Error('Missing builder result');run.stop();process.exit(result.success?0:1);})().catch(error=>{console.error(error);process.exit(1);});"],
      "options": { "cwd": "${workspaceFolder}", "env": { "NG_CLI_ANALYTICS": "false", "NG_BUILD_PARALLEL_TS": "0", "NG_BUILD_MAX_WORKERS": "1" } },
